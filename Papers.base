views:
  - type: table
    name: Papers
    filters:
      and:
        - file.folder == "wiki/sources"
    order:
      - file.name
      - title
      - authors
      - venue
      - year
      - status
      - citations
    sort:
      - property: year
        direction: ASC
    columnSize:
      file.name: 282
      note.title: 769
      note.venue: 79
